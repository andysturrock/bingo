{
  "name": "bingo-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "deploy": "npm run deploy --workspaces --if-present",
    "dev": "npm run dev -w packages/web"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.65.0",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "brace-expansion": "1.1.12"
  }
}